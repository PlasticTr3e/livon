# Copy to .env.production on the server and fill in every value.
# Use URL-safe secrets (e.g. `openssl rand -hex 32`): several are embedded in connection URLs.

# Public hostname nginx serves. Without a domain yet, use the server IP and run deploy/init-tls.sh --self-signed.
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
NEXT_PUBLIC_APP_URL=https://example.com

DATABASE_NAME=livon
DATABASE_USER=livon
DATABASE_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=livon-admin
MINIO_ROOT_PASSWORD=
S3_BUCKET=livon-media
S3_REGION=us-east-1
# Least-privilege credentials the app uses; created by the minio-init job.
S3_ACCESS_KEY=livon-app
S3_SECRET_KEY=
MAX_UPLOAD_MB=10

JWT_SECRET=

AI_SERVICE_API_KEY=

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
