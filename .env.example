# Local development. `docker compose up -d` starts Postgres, pgbouncer, Redis and MinIO with these values.

DATABASE_NAME=livon
DATABASE_USER=livon
DATABASE_PASSWORD=livon
DATABASE_URL=postgresql://livon:livon@localhost:6432/livon
DIRECT_URL=postgresql://livon:livon@localhost:5432/livon

REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=livon-media
S3_ACCESS_KEY=livon-app
S3_SECRET_KEY=livon-app-secret

JWT_SECRET=dev-only-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-ai-key

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
